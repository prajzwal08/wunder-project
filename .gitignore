# Cached logger data. Rebuilt from the API by `wunder.update_all()`.
# ~1.5 GB raw across 14 loggers, and it changes on every refresh -- never commit it.
# The 5-minute cache: ~106 MB, rebuilt from the API by wunder.update_all().
data/raw/

# The published 30-minute dataset IS committed (~25 MB) so a deployment with no cache
# starts instantly instead of re-downloading every history. Rebuild with
# `python -m wunder.publish`.
!data/published/

__pycache__/
*.pyc
.ipynb_checkpoints/
.streamlit/secrets.toml
.venv/
*.egg-info/

# Runtime logs
streamlit.log
*.log

# Working notes, kept local
CLAUDE.md
PLAN.md

# Model input built by forcing/make_input.py. ~24 MB, regenerated on every
# rebuild, and derived entirely from sources the scripts can re-fetch.
model_input/

# Forcing figures, regenerated with the files they describe.
plots/

# Model output.
runs/
